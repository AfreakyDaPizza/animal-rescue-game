# Copy this file to .env and fill it in. NEVER put .env on GitHub (it is in .gitignore).
# Bot token: discord.com/developers -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: discord.com/developers -> your app -> General Information
CLIENT_ID=
# Server ID: in Discord, Settings -> Advanced -> Developer Mode ON, then right-click your server -> Copy Server ID
GUILD_ID=
# Channel for rare-animal pings: right-click the channel -> Copy Channel ID
CHANNEL_ID=
# Role to ping (e.g. "Rare Hunters"): Server Settings -> Roles -> right-click the role -> Copy Role ID. Leave empty to ping nobody.
RARE_ROLE_ID=
